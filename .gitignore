# ---- build output -----------------------------------------------------------
# Emscripten site (deployed to GitHub Pages by CI, never committed)
dist/

# CMake build trees: one per kit (cmake-bld-Emscripten.local, cmake-bld-native.local),
# CMake Tools / IDE defaults (build, out, cmake-build-*). The embedded-resource
# headers (generated/resources/*.h) live inside them and are never committed.
cmake-bld*/
cmake-build*/
build/
out/
CMakeUserPresets.json
compile_commands.json

# generated by .devcontainer/host-platform.sh (engine arch for docker compose)
.devcontainer/.env

# ---- toolchains / sdk --------------------------------------------------------
# emsdk is baked into the devcontainer image at /opt/emsdk; ignore any local checkout
emsdk/
.emscripten_cache/

# ---- python (scripts/convert.py + linters) -------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---- editors / IDEs ------------------------------------------------------------
# Only the shared, tracked VS Code config is kept
.vscode/*
!.vscode/cmake-kits.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace
.idea/
.cache/
.clangd/
*.swp
*.swo
*~

# per-user Claude Code overrides
.claude/*.local.json

# ---- OS ------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---- logs ----------------------------------------------------------------------
*.log
